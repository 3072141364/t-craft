{
  "name": "computer-terms",
  "description": "计算机 / 软件 / 嵌入式领域常用术语表。术语提炼(terminology.md)时优先复用本表术语,避免新造或与现有术语冲突;命中即用,不命中再提炼。",
  "categories": {
    "architecture": "架构",
    "virtualization": "虚拟化/隔离",
    "simulation": "仿真/测试",
    "communication": "通信/协议",
    "data": "数据/存储",
    "method": "工程方法"
  },
  "terms": [
    { "term": "双域通信", "category": "communication", "definition": "仿真域与实车域各自有协议与逻辑,统一抽象成一套通信概念,降低两域对接的沟通成本", "example": "仿真和实车通讯存在诸多不便利,各自协议和逻辑不同" },
    { "term": "片内多环境模拟", "category": "simulation", "definition": "台架资源充足时,用虚拟隔离技术并行运行多个测试任务,避免单个任务浪费资源", "example": "台架上跑一个测试任务浪费资源,可虚拟隔离并行多个" },
    { "term": "硬件在环", "category": "simulation", "definition": "HIL,真实硬件接入仿真环境做测试", "aliases": ["HIL"] },
    { "term": "软件在环", "category": "simulation", "definition": "SIL,被测软件运行在通用计算平台的模拟环境中", "aliases": ["SIL"] },
    { "term": "模型在环", "category": "simulation", "definition": "MIL,控制模型直接与被控对象模型联测", "aliases": ["MIL"] },
    { "term": "实时仿真", "category": "simulation", "definition": "以真实时间节拍推进的仿真,可接入硬件做闭环" },
    { "term": "测试台架", "category": "simulation", "definition": "承载被测对象与测试环境的硬件设施", "aliases": ["台架", "bench"] },
    { "term": "虚拟化", "category": "virtualization", "definition": "用软件在共享物理资源上划分出多个隔离运行环境" },
    { "term": "容器", "category": "virtualization", "definition": "操作系统级隔离的轻量运行环境,共享宿主内核" },
    { "term": "虚拟机", "category": "virtualization", "definition": "硬件级虚拟化的完整客户机,拥有独立内核" },
    { "term": "沙箱", "category": "virtualization", "definition": "受限运行环境,隔离越权访问" },
    { "term": "多租户", "category": "virtualization", "definition": "一套系统服务多个租户,彼此数据与资源隔离" },
    { "term": "资源池", "category": "virtualization", "definition": "把空闲资源集中复用,按需分配" },
    { "term": "分时复用", "category": "virtualization", "definition": "多个任务按时间片共享同一资源" },
    { "term": "协议", "category": "communication", "definition": "通信双方约定的规则集合(格式 / 时序 / 错误处理)" },
    { "term": "总线", "category": "communication", "definition": "多设备共享的通信通道(CAN / LIN / 以太网等)" },
    { "term": "报文", "category": "communication", "definition": "一次通信传输的数据单元" },
    { "term": "网关", "category": "communication", "definition": "协议 / 域之间转换与路由的中介" },
    { "term": "域控制器", "category": "communication", "definition": "按功能域划分的集中控制单元" },
    { "term": "中间件", "category": "communication", "definition": "应用与系统之间的通用通信 / 服务层" },
    { "term": "序列化", "category": "communication", "definition": "把内存数据转成可传输 / 存储的格式" },
    { "term": "状态机", "category": "communication", "definition": "有限状态与迁移规则建模,描述状态流转" },
    { "term": "微服务", "category": "architecture", "definition": "按业务能力拆分的独立部署服务集合" },
    { "term": "事件驱动", "category": "architecture", "definition": "组件通过事件异步解耦交互" },
    { "term": "单体应用", "category": "architecture", "definition": "所有功能打包在一个部署单元里" },
    { "term": "抽象", "category": "method", "definition": "抽离共同特征、隐藏实现细节" },
    { "term": "解耦", "category": "method", "definition": "减少模块间的直接依赖" },
    { "term": "契约", "category": "method", "definition": "双方共同遵守的接口 / 格式约定" },
    { "term": "缓存", "category": "data", "definition": "把热数据放近端,减少重复计算 / IO" },
    { "term": "事务", "category": "data", "definition": "一组操作原子提交或整体回滚" },
    { "term": "一致性", "category": "data", "definition": "多副本 / 多节点数据保持约定的相同" }
  ]
}
