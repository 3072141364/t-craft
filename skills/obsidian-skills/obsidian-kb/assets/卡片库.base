filters:
  and:
    - 'file.ext == "md"'
    - or:
        - 'file.inFolder("项目")'
        - 'file.inFolder("通用")'
        - 'file.inFolder("日程")'
    - not:
        - 'file.inFolder("模板")'
    - not:
        - 'file.inFolder("通用/规范")'

properties:
  card_type:
    displayName: "类型"
  project:
    displayName: "项目"
  status:
    displayName: "状态"
  date:
    displayName: "日期"

views:
  - type: table
    name: "按类型"
    groupBy:
      property: card_type
      direction: ASC
    order:
      - file.name
      - project
      - status
      - date

  - type: table
    name: "进行中"
    filters:
      or:
        - 'status == "进行中"'
        - 'status == "草稿"'
    order:
      - file.name
      - card_type
      - project
      - date

  - type: table
    name: "按项目"
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - card_type
      - status
      - date
